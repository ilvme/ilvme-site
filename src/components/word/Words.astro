---
import { formatPast } from '../../libs/support'
import WordCard from './WordCard.astro'
import { fetchAllWords } from '../../libs/words-loader'
import type { Word } from '../../../scripts/archiving/types'
import SiteConfig from '../../ilvme.config'

const words: Word[] = await fetchAllWords()
---

<div class="max-h-[400px] space-y-4 overflow-auto border-2 border-gray-600/10 px-3 py-2 dark:border-gray-50/10">
  {words.map((word) => <WordCard word={word} />)}
</div>

<p class="text-secondary text-right text-xs">
  {
    SiteConfig.words_fetch_count === -1 ?
        <span>累积 {words.length} 条说说。</span>
        <span>第一条说说发布于 {formatPast(words[words.length - 1]?.time)}。 </span>
      :
      <span>仅获取最新 {SiteConfig.words_fetch_count} 条说说。</span>
  }
  <span>最近一条发布于 {formatPast(words[0].time)}。</span>
</p>
