---
const headings = Astro.props.headings
---

<div
  class="text-secondary fixed top-20 left-8 max-h-[calc(95vh-8rem)] w-56 overflow-y-auto border-l border-gray-300 pl-3 text-sm max-xl:hidden dark:border-gray-600"
>
  <div class="mb-2 text-base font-semibold">目录</div>
  <div class="space-y-1">
    {
      headings.map((heading) => (
        <div class={`${heading.depth === 2 ? 'font-medium' : 'ml-4'}`}>
          <a
            href={`#${heading.slug}`}
            class="block py-1 text-xs break-words whitespace-normal underline-offset-4 opacity-80 transition-opacity duration-200 hover:underline hover:opacity-100"
          >
            {heading.text}
          </a>
        </div>
      ))
    }
  </div>
</div>
