---
import { categoriesMeta, formatDate } from '../../libs/support'
const post = Astro.props.post

const isNotesPage = Astro.url.pathname.startsWith('/notes')
---

<div class="mb-3 block last:mb-0">
  <div class={`flex gap-3 before:content-['${post.category}']`}>
    <h2 class="relative flex-1">
      {
        !isNotesPage &&
          (Object.keys(categoriesMeta).includes(post.category) ? (
            <span class="absolute -left-10 rounded bg-[#f6f6f7] px-1 text-xs leading-6 text-gray-400 max-md:hidden">
              技术
            </span>
          ) : (
            ''
          ))
      }

      <a href={post.url} class="underline-offset-4 hover:underline 2xl:text-lg">
        {post.title}
      </a>
    </h2>
    <div class="text-secondary shrink-0 font-mono text-sm leading-6">{formatDate(post.date)}</div>
  </div>
</div>
