---
import '../../styles/markdown-image.css' // 引入图片样式

const classes = `prose
   dark:prose-invert"
  
  text-ink
  prose-p:text-ink
  prose-headings:text-ink
  prose-a:text-secondary
  
  lg:prose-base
  xl:prose-lg
  2xl:prose-xl 
  
  sm:prose-p:tracking-[.01em] 
  2xl:prose-p:tracking-[.04em] 
  
  prose-a:decoration-1
  
  prose-p:text-justify 

  prose-img:rounded-xl 
  
  prose-pre:w-[96%]
  prose-pre:mx-auto
  prose-pre:leading-5
  prose-code:before:content-none 
  prose-code:after:content-none 
  prose-code:text-rose-300
  prose-code:font-normal
  dark:prose-code:text-rose-400
  
  prose-blockquote:[&_p]:before:content-none 
  prose-blockquote:[&_p]:after:content-none 
  
  prose-thead:border
  prose-th:border
  prose-td:border
  
  prose-th:border-gray-300
  prose-td:border-gray-300
  dark:prose-th:border-gray-600
  dark:prose-td:border-gray-600
  prose-th:bg-[#f4f6f9]
  dark:prose-th:bg-[#191e24]
  prose-th:px-3
  prose-th:py-2
  prose-td:px-3
  prose-td:py-1.5
  
  prose-img:sm:w-[90%] 
  prose-img:mx-auto 
  
  prose-li:py-0
  prose-li:m-0
  prose-p:mt-0.5
  prose-p:mb-2
  
  prose-hr:mt-10
  prose-hr:mb-10
  dark:prose-hr:border-gray-500
  
  
  max-w-none
  leading-loose 
  break-words
`
---

<div class={classes}>
  <slot />
</div>
