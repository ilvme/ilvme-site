---

<button id="themeToggle">
  <svg width="14px" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
    <!-- 太阳图标 -->
    <path
      class="sun"
      fill-rule="evenodd"
      d="M12 17.5a5.5 5.5 0 1 0 0-11 5.5 5.5 0 0 0 0 11zm0 1.5a7 7 0 1 0 0-14 7 7 0 0 0 0 14zm12-7a.8.8 0 0 1-.8.8h-2.4a.8.8 0 0 1 0-1.6h2.4a.8.8 0 0 1 .8.8zM4 12a.8.8 0 0 1-.8.8H.8a.8.8 0 0 1 0-1.6h2.5a.8.8 0 0 1 .8.8zm16.5-8.5a.8.8 0 0 1 0 1l-1.8 1.8a.8.8 0 0 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM6.3 17.7a.8.8 0 0 1 0 1l-1.7 1.8a.8.8 0 1 1-1-1l1.7-1.8a.8.8 0 0 1 1 0zM12 0a.8.8 0 0 1 .8.8v2.5a.8.8 0 0 1-1.6 0V.8A.8.8 0 0 1 12 0zm0 20a.8.8 0 0 1 .8.8v2.4a.8.8 0 0 1-1.6 0v-2.4a.8.8 0 0 1 .8-.8zM3.5 3.5a.8.8 0 0 1 1 0l1.8 1.8a.8.8 0 1 1-1 1L3.5 4.6a.8.8 0 0 1 0-1zm14.2 14.2a.8.8 0 0 1 1 0l1.8 1.7a.8.8 0 0 1-1 1l-1.8-1.7a.8.8 0 0 1 0-1z"
    ></path>
    
    <!-- 月亮图标 -->
    <path
      class="moon"
      fill-rule="evenodd"
      d="M16.5 6A10.5 10.5 0 0 1 4.7 16.4 8.5 8.5 0 1 0 16.4 4.7l.1 1.3zm-1.7-2a9 9 0 0 1 .2 2 9 9 0 0 1-11 8.8 9.4 9.4 0 0 1-.8-.3c-.4 0-.8.3-.7.7a10 10 0 0 0 .3.8 10 10 0 0 0 9.2 6 10 10 0 0 0 4-19.2 9.7 9.7 0 0 0-.9-.3c-.3-.1-.7.3-.6.7a9 9 0 0 1 .3.8z"
    ></path>
    
    <!-- 电脑图标 -->
    <path
      class="system"
      fill-rule="evenodd"
      d="M4 2a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H4zm0 2h16v10H4V4zm2 12h2v2H6v-2zm4 0h2v2h-2v-2zm4 0h2v2h-2v-2z"
    ></path>
  </svg>
</button>

<style>
  #themeToggle {
    border: 0;
    background: none;
  }

  .sun, .moon, .system {
    fill: transparent;
  }

  :global(.dark) .sun {
    fill: transparent;
  }
  :global(.dark) .moon {
    fill: #fff;
  }
  :global(.dark) .system {
    fill: #fff;
  }
  
  .sun {
    fill: #666;
  }
  .system {
    fill: #666;
  }
</style>

<script is:inline>
  // 主题选项：system(跟随系统)、light(亮色)、dark(暗色)
  const THEME_OPTIONS = ['system', 'light', 'dark'];
  const DEFAULT_THEME = 'system';

  // 获取当前主题设置
  const getCurrentThemeSetting = () => {
    const savedTheme = localStorage?.getItem('theme') ?? DEFAULT_THEME;
    return THEME_OPTIONS.includes(savedTheme) ? savedTheme : DEFAULT_THEME;
  };

  // 获取实际应该应用的主题（基于设置和系统偏好计算）
  const getAppliedTheme = (themeSetting) => {
    if (themeSetting === 'light') return 'light';
    if (themeSetting === 'dark') return 'dark';
    
    // themeSetting === 'system'
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  };

  // 应用主题到页面
  const applyTheme = (theme) => {
    if (theme === 'dark') {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  };

  // 更新图标显示状态
  const updateIcon = (themeSetting) => {
    const sun = document.querySelector('.sun');
    const moon = document.querySelector('.moon');
    const system = document.querySelector('.system');
    
    // 隐藏所有图标
    if (sun) sun.style.fill = 'transparent';
    if (moon) moon.style.fill = 'transparent';
    if (system) system.style.fill = 'transparent';
    
    // 根据设置显示对应图标
    if (themeSetting === 'system') {
      if (system) system.style.fill = ''; // 显示电脑图标
    } else if (themeSetting === 'light') {
      if (sun) sun.style.fill = ''; // 显示太阳图标
    } else {
      if (moon) moon.style.fill = '#fff'; // 显示月亮图标
    }
  };

  // 初始化主题
  const initTheme = () => {
    const themeSetting = getCurrentThemeSetting();
    const appliedTheme = getAppliedTheme(themeSetting);
    applyTheme(appliedTheme);
    updateIcon(themeSetting);
    localStorage.setItem('theme', themeSetting);
    return { themeSetting, appliedTheme };
  };

  // 切换到下一个主题选项
  const cycleTheme = () => {
    const currentSetting = getCurrentThemeSetting();
    const currentIndex = THEME_OPTIONS.indexOf(currentSetting);
    const nextIndex = (currentIndex + 1) % THEME_OPTIONS.length;
    const nextSetting = THEME_OPTIONS[nextIndex];
    
    localStorage.setItem('theme', nextSetting);
    
    const appliedTheme = getAppliedTheme(nextSetting);
    applyTheme(appliedTheme);
    updateIcon(nextSetting);
    
    return { themeSetting: nextSetting, appliedTheme };
  };

  // 监听系统主题变化
  const handleSystemThemeChange = (e) => {
    const themeSetting = getCurrentThemeSetting();
    // 只有当设置为跟随系统时才响应系统主题变化
    if (themeSetting === 'system') {
      const appliedTheme = e.matches ? 'dark' : 'light';
      applyTheme(appliedTheme);
      updateIcon(themeSetting); // 更新图标显示
    }
  };

  // 初始化
  initTheme();

  // 添加按钮点击事件
  document.getElementById('themeToggle')?.addEventListener('click', cycleTheme);

  // 监听系统主题变化
  const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
  mediaQuery.addEventListener('change', handleSystemThemeChange);
</script>