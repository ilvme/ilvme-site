---
import '@/styles/global.css'
import BackToTop from '@/components/ui/BackToTop.astro'
import SiteConfig from '@/ilvme.config'

const { title = SiteConfig.title, description = SiteConfig.description, icon } = Astro.props
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!--<link rel="icon" type="image/svg+xml" href="/favicon.svg" />-->
    <link rel="alternate" type="application/rss+xml" title={title} href={new URL('rss.xml', Astro.site)} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{icon}{title}</title>
  </head>
  <body>
    <main class="mx-auto w-[80%] pt-6 lg:pt-10">
      <slot />

      <BackToTop />
    </main>
  </body>
</html>
