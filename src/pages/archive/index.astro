---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostItemArchive from '../../components/post/PostItemArchive.astro'
import { getAllPosts } from '../../libs/content-loader'
import PageHero from '../../components/post/PageHero.astro'
import { calcAllWords } from '../../libs/aou'
import dayjs from 'dayjs'

const allPosts = await getAllPosts()

const postsByYear = allPosts.reduce(
  (acc, post) => {
    const year = dayjs(post.data.date).format('YYYY')
    if (!acc[year]) {
      acc[year] = []
    }
    acc[year].push(post)
    return acc
  },
  {} as Record<string, typeof allPosts>
)

const sortedYears = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a))
---

<BaseLayout>
  <PageHero title="归档">
    <p class="">共 {allPosts.length} 篇文章，约 {calcAllWords()} 字。</p>
  </PageHero>

  <main>
    {
      sortedYears.map((year) => (
        <section class="mb-10">
          <h2 class="mb-4 text-2xl font-bold">{year}</h2>
          <div>
            {postsByYear[year].map((post) => (
              <PostItemArchive key={post.id} post={{ url: `/posts/${post.id}`, ...post.data }} />
            ))}
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>
