---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostItemArchive from '../../components/post/PostItemArchive.astro'
import { getAllNotes } from '../../libs/content-loader'
import PageHero from '../../components/post/PageHero.astro'

const allNotes = await getAllNotes()
---

<BaseLayout title="技术笔记">
  <PageHero title="技术笔记">
    <p class="">共有 {allNotes.length} 篇文章。</p>
  </PageHero>

  <main class="-mt-3">
    {allNotes.map((post) => <PostItemArchive key={post.id} post={{ url: '/posts/' + post.id, ...post.data }} />)}
  </main>
</BaseLayout>
