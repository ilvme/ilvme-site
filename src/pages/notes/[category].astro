---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostItemArchive from '../../components/post/PostItemArchive.astro'
import { getAllNotes } from '../../libs/content-loader'
import PageHero from '../../components/post/PageHero.astro'
import { categoriesMeta } from '../../libs/support'

export async function getStaticPaths() {
  const allNotes = await getAllNotes()

  const uniqueCategories = [...new Set(allNotes.flatMap((post: any) => post.data.category))]
  uniqueCategories.unshift('all')

  return uniqueCategories.map((category) => {
    if (category === 'all') {
      return {
        params: { category },
        props: { posts: allNotes, allCategories: uniqueCategories },
      }
    }

    const filteredPosts = allNotes.filter((post: any) => post.data.category === category)
    return {
      params: { category },
      props: { posts: filteredPosts, allCategories: uniqueCategories },
    }
  })
}

const { category } = Astro.params
const { posts, allCategories } = Astro.props
---

<BaseLayout title="技术笔记">
  <PageHero title="技术笔记">
    {
      allCategories.map((c) => (
        <a
          key={c}
          class={`mr-2 inline-block rounded-lg bg-gray-100 px-2 py-1 text-sm text-gray-600 hover:bg-rose-100 ${category === c ? 'bg-rose-100 font-bold' : ''}`}
          href={`/notes/${c}`}
        >
          {categoriesMeta.find((item) => item.name === c)?.label}
        </a>
      ))
    }
  </PageHero>

  <main class="-mt-3">
    {posts.map((post) => <PostItemArchive post={{ url: '/posts/' + post.id, ...post.data }} />)}
  </main>
</BaseLayout>
