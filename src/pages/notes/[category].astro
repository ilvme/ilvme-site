---
import BaseLayout from '../../layouts/BaseLayout.astro'
import PostItemArchive from '../../components/post/PostItemArchive.astro'
import { getAllNotes } from '../../libs/content-loader'
import PageHero from '../../components/post/PageHero.astro'
import { categoriesMeta } from '../../libs/support'

export async function getStaticPaths() {
  const allNotes = await getAllNotes()

  const uniqueCategories = [...new Set(allNotes.flatMap((post: any) => post.data.category))]
  uniqueCategories.unshift('all')

  // 分别统计每个类别的文章数
  const categoriesInfo = uniqueCategories.map((category) => {
    if (category === 'all') {
      return {
        name: 'all',
        label: '全部',
        count: allNotes.length,
      }
    }

    return {
      name: category,
      label: categoriesMeta.find((item) => item.name === category)?.label || category,
      count: allNotes.filter((post: any) => post.data.category === category).length,
    }
  })

  return uniqueCategories.map((category) => {
    if (category === 'all') {
      return {
        params: { category },
        props: { posts: allNotes, allCategories: categoriesInfo },
      }
    }

    const filteredPosts = allNotes.filter((post: any) => post.data.category === category)
    return {
      params: { category },
      props: { posts: filteredPosts, allCategories: categoriesInfo },
    }
  })
}

const { category } = Astro.params
const { posts, allCategories } = Astro.props
---

<BaseLayout title="技术笔记">
  <PageHero title="技术笔记">
    {
      allCategories.map((c) => (
        <a
          key={c}
          class={`mr-2 inline-block rounded-lg bg-gray-100 px-2 py-1 text-sm text-gray-600 hover:bg-rose-100 ${category === c.name ? 'bg-rose-100 font-bold' : ''}`}
          href={`/notes/${c.name}`}
        >
          {c.label}
          <span class="text-xs">{c.count ? ` (${c.count})` : ''}</span>
        </a>
      ))
    }
  </PageHero>

  <main class="-mt-3">
    {posts.map((post) => <PostItemArchive post={{ url: '/posts/' + post.id, ...post.data }} />)}
  </main>
</BaseLayout>
